# Supabase project settings (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by API routes to seed movies from TMDB.
# Never expose this to the browser (do not prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# TMDB (https://www.themoviedb.org/settings/api) - movie content
TMDB_API_KEY=

# RapidAPI - Streaming Availability API (for the "where to watch" feature)
RAPID_API_KEY=
RAPID_API_HOST=streaming-availability.p.rapidapi.com
